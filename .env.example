# Required
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Discord
COMMAND_PREFIX=!
# Join automatically when a human enters a voice channel; leave when it empties.
AUTOJOIN=true

# Wyoming ASR — hostname or service name of the ASR server.
WYOMING_HOST=localhost
WYOMING_PORT=10300
STT_LANGUAGE=en
MAX_CONCURRENT_TRANSCRIPTIONS=4

# Wyoming TTS — only used by tools that answer out loud.
TTS_HOST=localhost
TTS_PORT=10200
# Leave empty to take whatever the synthesizer considers its default.
TTS_VOICE=
# How long to wait on the synthesizer for the next piece of a clip.
TTS_TIMEOUT_SECONDS=30
# How long the player waits mid-clip before giving up on the rest of it.
TTS_STALL_SECONDS=10
# How much speech to have in hand before a clip starts, in milliseconds. Covers
# a synthesizer that renders a phrase whole before sending any of it, which
# otherwise leaves a gap between a chime and the words behind it. 0 starts on
# the first chunk.
TTS_LEAD_MS=500

# Scales everything played into a channel, chime included, where 1 is however
# loud the synthesizer rendered it. 0.8 is 20% quieter, 1.2 is 20% louder.
PLAYBACK_VOLUME=1

# Rendered speech, so a phrase is only ever synthesized once. Mount a volume
# here to keep it across restarts.
TTS_CACHE_DIR=/cache/tts
TTS_CACHE_ENTRIES=256
# Days a rendered clip survives without being played, counted from the last time
# it was. 0 (or any value below 1) keeps them forever. Clips left in the
# directory by hand, such as a chime, are never reaped.
TTS_CACHE_RETENTION_DAYS=90

# Credits — the running tally the verbal-morality tool keeps. Mount a volume at
# the directory holding this file to keep what everybody owes across restarts.
CREDITS_FILE=/credits/credits.json
# How often a changed tally is written to disk. Cheap, so it is quick: a pod
# killed outright loses this many seconds of fines. 0 (or below) keeps the tally
# in memory and writes it only on shutdown.
CREDITS_SAVE_SECONDS=5
# How often a changed tally is published to the voice channel topic — the line
# the client shows under the channel name, which is set as the channel status
# because a voice channel has no topic. Discord's bucket for it is roughly six a
# second, so this is set by how often a tally is worth reading rather than by a
# rate limit. 0 (or below) keeps the tally off the channel, and still counts and
# saves it. Needs Set Voice Channel Status on the channel.
CREDITS_TOPIC_SECONDS=10

# The quietest a fine is announced, as a fraction of PLAYBACK_VOLUME, once
# somebody has sworn enough in five minutes to earn the full backoff. Each
# violation takes 5% off. 0 silences a repeat offender entirely; 1 turns the
# backoff off, there being nowhere to back off to.
VIOLATION_VOLUME_FLOOR=0.25

# Transcripts
TRANSCRIPT_DIR=/transcripts
# Governs both the rollover boundary and the timestamp offset.
TZ=America/Los_Angeles
# Days of transcripts to keep. -1 (or any value below 1) keeps them forever.
RETENTION_DAYS=-1

# Speech segmentation
SPEECH_FLUSH_TIMEOUT_SECONDS=2.0
USER_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO
