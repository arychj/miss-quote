# Required
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Discord
COMMAND_PREFIX=!
# Join automatically when a human enters a voice channel; leave when it empties.
AUTOJOIN=true

# Wyoming ASR — hostname or service name of the ASR server.
WYOMING_HOST=localhost
WYOMING_PORT=10300
STT_LANGUAGE=en
MAX_CONCURRENT_TRANSCRIPTIONS=4

# Transcripts
TRANSCRIPT_DIR=/transcripts
# Governs both the rollover boundary and the timestamp offset.
TZ=America/Los_Angeles
# Days of transcripts to keep. -1 (or any value below 1) keeps them forever.
RETENTION_DAYS=-1

# Speech segmentation
SPEECH_FLUSH_TIMEOUT_SECONDS=2.0
USER_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO
