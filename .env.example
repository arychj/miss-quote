# What a deployment points at. How it behaves is config.yaml — see the
# `settings:` block there for backoffs, retention, what a credit is called, and
# everything else that is a number rather than an address.

# Required
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Servers, rosters, tools, and settings. Mounted at /config/config.yaml from a
# ConfigMap; point this elsewhere to override the location.
CONFIG_FILE=/config/config.yaml

# Discord
COMMAND_PREFIX=!
# Join automatically when a human enters a voice channel; leave when it empties.
AUTOJOIN=true

# Wyoming ASR — hostname or service name of the ASR server.
WYOMING_HOST=localhost
WYOMING_PORT=10300
STT_LANGUAGE=en
MAX_CONCURRENT_TRANSCRIPTIONS=4

# Wyoming TTS — only used by tools that answer out loud.
TTS_HOST=localhost
TTS_PORT=10200
# Leave empty to take whatever the synthesizer considers its default.
TTS_VOICE=

# Scales everything played into a channel, chime included, where 1 is however
# loud the synthesizer rendered it. 0.8 is 20% quieter, 1.2 is 20% louder.
#
# Also decides how cached clips reach Discord. At 1 they are sent exactly as
# stored; anything lower has to be decoded and re-encoded on every play, so
# turning a channel down costs CPU as well as loudness.
PLAYBACK_VOLUME=1

# Audio on disk, as one root with a directory per kind:
#
#   speech/cache   Rendered speech, so a phrase is only ever synthesized once.
#                  Written and reaped by the bot. Kept as Ogg Opus, which is
#                  what Discord is sent, so a cached phrase costs nothing to
#                  play and the files are still something you can listen to.
#                  This is the only place clips are kept, so mount a writable
#                  volume here — without one every phrase is synthesized again
#                  every time it is said. How long a clip survives is
#                  settings.tts.cache_retention_days.
#
#   speech/chimes  Clips you put there by hand, played ahead of what a tool has
#                  to say. 16-bit WAV, named from a tool's `chime:` setting.
#                  Never written to and never reaped.
SPEECH_DIR=/speech

# Credits — the running tally the scoreboard tool keeps for every server that
# enables it. Mount a volume at the directory holding this file to keep what
# everybody owes across restarts. A fine is a debit: everybody starts at 0 and
# goes down from there, and the channel topic shows the four furthest into the
# red.
CREDITS_FILE=/credits/credits.json

# Quotes — the triggers and film lines the quotes tool answers with, as a CSV of
# movie,trigger,quote. One list per deployment; the image ships the one in
# resources/. Mount your own over this path, or point this at it.
QUOTES_FILE=/app/src/miss_quote/resources/quotes.csv

# An OpenAI-compatible chat-completions endpoint — only used by the summary
# tool. The root has /chat/completions appended to it, so point it at whatever
# serves that: a hosted API, a gateway in front of one, or a model running on
# the next machine over. Leave the key empty for an endpoint that wants none;
# an empty key sends no Authorization header rather than an empty credential.
LLM_API_BASE=http://localhost:8080/v1
LLM_API_KEY=
LLM_MODEL=

# Transcripts
TRANSCRIPT_DIR=/transcripts
# Governs both the rollover boundary and the timestamp offset.
TZ=America/Los_Angeles

# Summaries — one account of a session per transcript, filed the same way and
# named for the transcript it describes. A separate root from the transcripts
# so the two can be mounted and shared on different terms; how long they are
# kept is settings.summaries.retention_days.
SUMMARY_DIR=/summaries

# Speech segmentation
SPEECH_FLUSH_TIMEOUT_SECONDS=2.0
USER_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO
